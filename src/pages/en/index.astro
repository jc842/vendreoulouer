---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog-en');
---

<Layout title="Vendre ou Louer — Selling vs Renting Property in the French Caribbean" lang="en">
  <section class="border-b border-slate-800 bg-[#090e17] py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-amber-500/30 bg-amber-950/30 px-3.5 py-1 text-xs text-amber-300 font-semibold mb-4">
        PROPERTY ARBITRATION GUIDE
      </div>
      <h1 class="text-3xl font-extrabold text-white sm:text-5xl">Sell or Lease Your Caribbean Property</h1>
      <p class="mt-4 max-w-2xl text-slate-300 text-sm sm:text-base leading-relaxed font-light">
        Comparative financial and tax modeling between immediate property liquidation and holiday rental returns across the French West Indies.
      </p>
    </div>
  </section>

  <section class="py-12 bg-[#090e17]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {posts.map(post => (
          <article class="flex flex-col justify-between rounded-xl border border-slate-800 bg-[#0d1522]/50 p-6 hover:border-amber-500/50 transition-colors">
            <div>
              <span class="rounded bg-amber-950 px-2 py-0.5 text-[11px] text-amber-300 font-semibold">{post.data.category}</span>
              <h2 class="text-lg font-bold text-white mt-3 hover:text-amber-400 transition-colors">
                <a href={'/en/' + post.id + '/'}>{post.data.title}</a>
              </h2>
              <p class="mt-2 text-xs text-slate-400 leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-800 text-xs">
              <a href={'/en/' + post.id + '/'} class="text-amber-400 hover:underline font-semibold">Read Guide →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
