---
import ReviveSlot from '../components/ads/ReviveSlot.astro';
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
const featuredPosts = sortedPosts.slice(0, 6);
const remainingPosts = sortedPosts.slice(6, 40);
---

<Layout title="Vendre ou Louer — Portail des Décisions Immobilières aux Antilles : Vente, Location & Stratégie Patrimoniale">
  <!-- Hero Section Dusk -->
  <section class="relative border-b border-slate-800/80 bg-[#090e17] py-16 sm:py-24 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-amber-900/15 via-transparent to-transparent"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
      
      <!-- Top Pill -->
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-amber-500/30 bg-amber-950/30 px-3.5 py-1.5 text-xs text-amber-300 font-semibold">
        <span class="h-2 w-2 rounded-full bg-amber-400"></span>
        STRATÉGIE PATRIMONIALE ANTILLAISE
      </div>

      <!-- Headline -->
      <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl max-w-4xl leading-tight">
        Vendre ou Louer votre Bien aux <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-200">Antilles Françaises</span> ?
      </h1>

      <p class="mt-6 max-w-2xl text-base sm:text-lg text-slate-300 leading-relaxed font-light">
        Arbitrage chiffré entre vente immédiate et mise en location saisonnière ou résidentielle : estimation objective du marché, fiscalité des plus-values et optimisation du rendement net.
      </p>

      <!-- Key Pillars Row -->
      <div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-4 lg:gap-6">
        <div class="rounded-xl border border-slate-800 bg-[#0e1625]/60 p-5 backdrop-blur-sm">
          <div class="text-[11px] text-amber-400 uppercase tracking-widest font-semibold">Arbitrage Net</div>
          <div class="mt-2 text-2xl font-bold text-white">Vente vs Bail</div>
          <div class="mt-1 text-xs text-slate-400">Comparaison financière chiffrée</div>
        </div>
        <div class="rounded-xl border border-slate-800 bg-[#0e1625]/60 p-5 backdrop-blur-sm">
          <div class="text-[11px] text-amber-400 uppercase tracking-widest font-semibold">Plus-Value</div>
          <div class="mt-2 text-2xl font-bold text-amber-400">Abattements</div>
          <div class="mt-1 text-xs text-slate-400">Exonération progressive 22/30 ans</div>
        </div>
        <div class="rounded-xl border border-slate-800 bg-[#0e1625]/60 p-5 backdrop-blur-sm">
          <div class="text-[11px] text-amber-400 uppercase tracking-widest font-semibold">Rendement Saisonnier</div>
          <div class="mt-2 text-2xl font-bold text-white">7% à 11%</div>
          <div class="mt-1 text-xs text-slate-400">Locations meublées touristiques</div>
        </div>
        <div class="rounded-xl border border-slate-800 bg-[#0e1625]/60 p-5 backdrop-blur-sm">
          <div class="text-[11px] text-amber-400 uppercase tracking-widest font-semibold">Sécurité Actes</div>
          <div class="mt-2 text-2xl font-bold text-slate-200">Base Notariale</div>
          <div class="mt-1 text-xs text-slate-400">Prix réels enregistrés</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Bento Articles -->
  <section class="py-16 sm:py-20 bg-[#090e17] border-b border-slate-800">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="flex items-center justify-between mb-10">
        <div>
          <span class="text-xs uppercase tracking-widest text-amber-400 font-semibold">Guides & Analyses de Décision</span>
          <h2 class="text-2xl font-bold text-white sm:text-3xl mt-1">Derniers Dossiers Stratégiques</h2>
        </div>
        <a href="/blog/" class="hidden sm:inline-flex items-center gap-2 text-xs text-amber-400 hover:text-amber-300 font-semibold">
          TOUS LES ARTICLES →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredPosts.map((post) => (
          <article class="group relative flex flex-col justify-between rounded-xl border border-slate-800 bg-[#0d1522]/50 p-6 transition-all duration-300 hover:border-amber-500/40 hover:bg-[#0d1522]/90">
            <div>
              <div class="flex items-center justify-between text-[11px] text-slate-400 mb-3">
                <span class="rounded bg-amber-950/80 px-2 py-0.5 text-amber-300 font-semibold">{post.data.category || 'Décision'}</span>
                <span>{new Date(post.data.pubDate).toLocaleDateString('fr-FR', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
              </div>
              <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors line-clamp-2 leading-snug">
                <a href={'/blog/' + post.id + '/'}>
                  {post.data.title}
                </a>
              </h3>
              <p class="mt-3 text-xs text-slate-400 line-clamp-3 leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs">
              <span class="text-slate-500">Dossier Arbitrage</span>
              <a href={'/blog/' + post.id + '/'} class="text-amber-400 hover:underline flex items-center gap-1 font-semibold">
                Consulter l'analyse →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Extended Library -->
  <section class="py-16 bg-[#060a12]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-2xl font-bold text-white mb-8">
        Guides Notariés, Gestion Locative & Fiscalité Immobilière
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {remainingPosts.map(post => (
          <div class="flex items-start justify-between rounded-lg border border-slate-800/80 bg-[#0c1320]/40 p-4 hover:border-amber-900/60 transition-colors">
            <div class="pr-4">
              <span class="text-[10px] text-amber-400 uppercase tracking-wider font-semibold">{post.data.category || 'Article'}</span>
              <h4 class="text-sm font-semibold text-slate-200 mt-1 hover:text-amber-300 transition-colors">
                <a href={'/blog/' + post.id + '/'}>{post.data.title}</a>
              </h4>
            </div>
            <a href={'/blog/' + post.id + '/'} class="text-xs text-amber-400 whitespace-nowrap pt-1 font-semibold">
              Lire →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
  <!-- Emplacement Publicitaire Revive In-Content -->
  <div class="my-14 flex justify-center">
    <ReviveSlot slot="inContent" />
  </div>
</Layout>
